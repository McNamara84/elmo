{
    "name": "elmo/elmo",
    "description": "ELMO - Enhanced Linked Metadata Organizer. A metadata editor for research metadata of EPOS MSL data.",
    "type": "project",
    "keywords": [
        "editor",
        "research",
        "metadata",
        "epos",
        "msl"
    ],
    "homepage": "https://env.rz-vm182.gfz.de/elmo/",
    "readme": "README.md",
    "time": "2025-02-03",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Holger Ehrmann",
            "email": "ehrmann@gfz.de",
            "homepage": "https://gfz.de",
            "role": "Developer"
        },
        {
            "name": "Jana Franz",
            "role": "Developer"
        },
        {
            "name": "Nina Rethfeldt",
            "email": "nina.rethfeldt@fh-potsdam.de",
            "homepage": "https://www.fh-potsdam.de/",
            "role": "Software tester"
        }
    ],
    "support": {
        "email": "ehrmann@gfz.de",
        "issues": "https://github.com/McNamara84/elmo/issues",
        "docs": "https://github.com/McNamara84/elmo"
    },
    "require": {
        "php": "^8.3 || ^8.4 || ^8.5",
        "nikic/fast-route": "^1.3",
        "phpmailer/phpmailer": "^7.1.1"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^8.0",
        "phpstan/phpstan": "^2.2.1",
        "phpunit/phpunit": "^13.1.13"
    },
    "autoload": {
        "classmap": [
            "."
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "check:file-names": "php scripts/check_file_names.php",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit"
        ]
    }
}
