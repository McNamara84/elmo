# Local environment for running ELMO with Docker.
# Copy this file to .env and replace the placeholder API keys.
# Feature flags live in feature_flags.php.
# Mail is simulated in the local compose file and is not configured here.
# Database variables apply when the database volume is created. After a credential
# change, reset that volume with: docker compose down -v

# Database
ROOT_PASSWORD=password
DB_HOST=db
DB_USER=elmo
DB_PASSWORD=password
DB_NAME=elmocache

# ELMO API key. External services use this to authenticate with ELMO.
ELMO_API_KEY=your_elmo_api_key

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Map ID required for AdvancedMarkerElement
GOOGLE_MAPS_MAP_ID=your-map-id-here

# API key for https://timezonedb.com/
TIMEZONE_API_KEY=your_timezone_api_key

# ERNIE vocabulary service. ERNIE_API_KEY is used by ELMO to authenticate with ERNIE.
ERNIE_URL=https://dataservices.gfz.de/
ERNIE_API_KEY=your_ernie_api_key

# DataCite JSON-LD @context. Empty falls back to the DataCite stage context.
DATACITE_JSONLD_CONTEXT_URL=https://schema.stage.datacite.org/linked-data/context/fullcontext.jsonld

# Nextcloud folder shown after a successful metadata submission.
DATA_UPLOAD_URL=https://nextcloud.gfz.de/s/xxxxxxxxxxxxxx

# Funder identifier mode: CFID = Crossref Funder ID, ROR = ROR ID
FUNDER_PID=CFID

# For testing
API_BASE_URL=http://localhost:8000
