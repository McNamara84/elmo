ROOT_PASSWORD=Sup3rSecretRoot
DB_HOST=localhost
DB_USER=username
DB_PASSWORD=password
DB_NAME=dbname
GOOGLE_MAPS_API_KEY = 1234-1234-1234-1234
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_SENDER=your_smtp_sender_email
FEEDBACK_ADDRESS=feedback@example.com
XML_SUBMIT_ADDRESS=xmlsubmit@example.com

# API Keys for Service-to-Service Communication
# ELMO_API_KEY: Used by external services (ERNIE) to authenticate with ELMO (ERNIE → ELMO)
ELMO_API_KEY=your_elmo_api_key

# ERNIE Integration (External Vocabulary Service)
# ERNIE_API_KEY: Used by ELMO to authenticate with ERNIE (ELMO → ERNIE)
ERNIE_URL=https://ernie.rz-vm499.gfz.de/
ERNIE_API_KEY=your_ernie_api_key

# Funder PID mode: CFID = Crossref Funder ID, ROR = ROR ID
FUNDER_PID=CFID

# URL for primary data upload (Nextcloud)
# Shown to users after successful metadata submission
DATA_UPLOAD_URL=https://nextcloud.gfz.de/s/xxxxxxxxxxxxxx