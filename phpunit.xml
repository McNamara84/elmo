<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    colors="true">
    <testsuites>
        <testsuite name="SaveTests">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    
    <!-- Coverage configuration for PHPUnit 12 -->
    <coverage includeUncoveredFiles="true">
        <report>
            <clover outputFile="clover.xml" />
        </report>
    </coverage>
    
    <source>
        <include>
            <!-- Only include directories with testable code -->
            <directory suffix=".php">./save</directory>
            <directory suffix=".php">./api/v2/controllers</directory>
            <directory suffix=".php">./includes</directory>
            <!-- Include specific testable files -->
            <file>./api_functions.php</file>
            <file>./generate_xml_files.php</file>
            <file>./log_page_event.php</file>
        </include>
    </source>
</phpunit>