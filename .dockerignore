# Ignore version control directories
.git/
.hg/
.svn/

# Ignore IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# Ignore temporary and log files
*.log
*.tmp
tmp/
temp/
.tmp/


# Ignore environment and secret files
.env*
*.pem
*.key
*.crt
**/.env*
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx
**/*.sql
settings.php
**/settings.php
test-settings.php
**/test-settings.php
playwright-variant-lock.php
.ssh/
.aws/
.codex/
.agents/
.github/
scripts/ci/
.docker/
**/.npmrc
**/.netrc
**/.pypirc
**/.git-credentials
**/.dockercfg
**/auth.json

# Ignore documentation and markdown files
docs/
*.md
README*

# Ignore Docker-related files
Dockerfile*
docker-compose*

# Ignore test and debug files
tests/
*_test.go
debug/

# Ignore language-specific patterns
node_modules/
vendor/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
coverage/
coverage-*/
coverage-report*/
playwright-report*/
test-results/
storage/
xml/

# Ignore project-specific patterns
config.local.*
*.local.yml

# Ignore other unnecessary files
*.xsd
*.xml
*.mfd

# Ensure essential files are not ignored
!api/
!save/


xml_submit_backup.txt
