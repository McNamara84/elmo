# ELMO API Key: Used by external services (ERNIE) to authenticate with ELMO (ERNIE → ELMO)
ELMO_API_KEY=your_elmo_api_key

# Google Maps API Key
GOOGLE_MAPS_API_KEY=1234-1234-1234-1234
# Google Maps Map ID (required for AdvancedMarkerElement)
GOOGLE_MAPS_MAP_ID=your-map-id-here

# API Key for https://timezonedb.com/
TIMEZONE_API_KEY=your_timezone_api_key

# ERNIE Integration (External Vocabulary Service)
# ERNIE_API_KEY: Used by ELMO to authenticate with ERNIE (ELMO → ERNIE)
ERNIE_URL=https://dataservices.gfz.de/
ERNIE_API_KEY=your_ernie_api_key

# Funder PID mode: CFID = Crossref Funder ID, ROR = ROR ID
FUNDER_PID=CFID

# URL for primary data upload (Nextcloud)
# Shown to users after successful metadata submission
DATA_UPLOAD_URL=https://nextcloud.gfz.de/s/xxxxxxxxxxxxxx

# MSL mode. Labs, vocabularies, default free keywords, and the logo follow this value.
SHOW_MSL_MODE=false

# ICGEM / GGMs form groups
SHOW_GGMS_PROPERTIES=false
# ELMO GEM only (SHOW_GGMS_PROPERTIES=true). Set false to skip confirmation emails
# to contact persons and organisations, for example while loading existing models.
SEND_RESEARCHER_CONFIRMATION_EMAIL=true
# ELMO GEM only. Upload interface linked from the ICGEM registration mail.
ICGEM_UPLOAD_URL=https://icgem.gfz.de/upload

SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_SENDER=your_smtp_sender_email
SMTP_SECURE=tls
SMTP_AUTH=true
FEEDBACK_ADDRESS=feedback@example.com
XML_SUBMIT_ADDRESS=xmlsubmit@example.com
# ELMO GEM: ICGEM registration mail recipient (Data Services still uses XML_SUBMIT_ADDRESS)
ICGEM_SUBMIT_ADDRESS=icgem@gfz.de
