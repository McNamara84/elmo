# syntax=docker/dockerfile:1.7

# ====== Stage 1: Base ======
FROM php:8.5-apache-bookworm AS base

ARG DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libxml2-dev \
        libxslt-dev \
        libzip-dev \
        mariadb-client \
    && rm -rf /var/lib/apt/lists/* \
    && docker-php-ext-install -j"$(nproc)" \
        mysqli \
        pdo_mysql \
        xsl \
        zip

ENV APACHE_DOCUMENT_ROOT=/var/www/html
RUN sed -ri "s!/var/www/html!${APACHE_DOCUMENT_ROOT}!g" /etc/apache2/sites-available/000-default.conf \
    && a2enmod rewrite deflate headers expires

COPY docker/apache-gzip.conf /etc/apache2/conf-available/gzip.conf
RUN a2enconf gzip

WORKDIR /var/www/html

# ====== Stage 2: Dev ======
FROM base AS dev

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

COPY composer.json composer.lock package.json package-lock.json ./
RUN composer install --prefer-dist --no-interaction --no-scripts \
    && npm install

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["apache2-foreground"]

# ====== Stage 3: Builder ======
FROM dev AS builder

WORKDIR /var/www/html
COPY . .

RUN composer install --no-dev --prefer-dist --optimize-autoloader --no-interaction --no-scripts \
    && npm install --omit=dev

# ====== Stage 4: Prod ======
FROM base AS prod

ARG DEBIAN_FRONTEND=noninteractive

# Purge dev packages FIRST, then install runtime
RUN apt-get update && \
    apt-get purge -y libxml2-dev libxslt-dev libzip-dev && \
    apt-get install -y --no-install-recommends libxml2 libxslt1.1 libzip5 && \
    apt-get autoremove -y --purge && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user and set up directories ONCE
RUN useradd -r -u 1000 -g www-data appuser && \
    mkdir -p /var/www/html/xml /var/www/html/storage && \
    chown -R appuser:www-data /var/www/html

WORKDIR /var/www/html

# Copy built assets
COPY --from=builder --chown=appuser:www-data /var/www/html /var/www/html

# Copy entrypoint
COPY --chown=appuser:www-data docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

USER appuser

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["apache2-foreground"]